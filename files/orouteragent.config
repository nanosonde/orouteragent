# orouteragent UCI configuration
#
# The agent makes this OpenWrt router appear to a TP-L*nk Om*d* Software
# Controller as the gateway model selected below. All configuration lives
# in this file; see README for the full option reference.

config agent 'agent'
	# Master switch. 0 = daemon idles (started but inactive).
	option enabled 0

# Emulated Om*d* gateway model:
        # ER605 | ER706W | ER7206 | ER707-M2 | ER8411.
        # Unknown strings fall back to ER707-M2.
        option model 'ER707-M2'

        # Hardware/model revision reported to the controller.
        option hw_version '1.0'

	# Device MAC reported to the controller (hyphenated uppercase or any
	# common notation). When empty, the LAN MAC of the router is used.
	option mac ''

	# Optional: mark the gateway as WiFi-capable (emulated wireless
	# reporting). Auto-detected from the model when empty; set explicitly
	# only for non-WiFi hardware emulating a WiFi model.
	option wireless ''

	# Om*d* controller address (IP or FQDN). When set, discovery announces
	# are sent unicast to this host; when empty, they are broadcast.
	option controller ''

	# Om*d* controller HTTPS port for /api/info (controller ID lookup).
	option controller_port 8043

	# discovery: auto | unicast | broadcast
	# auto   = unicast when 'controller' is set, broadcast otherwise
	# unicast = force unicast to 'controller' (error if unset)
	# broadcast = force broadcast
	option discovery_mode 'auto'

	# TLS: the controller presents a vendor certificate (CN=localhost);
	# verification is off by default. Set to 1 to verify against a CA
	# bundle (requires the controller's real certificate chain).
	option verify_tls 0

	# Device account used during adoption. Must match what the operator
	# enters when adopting. The controller normally provisions the site
	# Device Account during initial sync; these are fallbacks.
	option device_username 'admin'
	option device_password 'admin'

	# Optional hard overrides for the managed (site) Device Account, used
	# if the controller does not send one during initial sync.
	option managed_username ''
	option managed_password ''

	# TLS management (adopt) port on the controller.
	option adopt_port 29814

	# Seconds between INFORM heartbeats once adopted.
	option inform_interval 10

	# Persistent state file (config version, controller ID, device account,
	# stored SET blobs).
	option state_file '/etc/orouteragent/state.json'

	# Maximum size (KB) of stored controller config blobs.
	option max_config_kb 512

	# syslog level: 0=err 1=warn 2=info 3=debug
	# Debug includes frames and redacted, chunked GET/SET bodies.
	option log_level 2

# Optional port mapping: emulated Om*d* port number -> real OpenWrt
# interface. Port 1 is the emulated WAN port by default.
# Without any portmap sections the agent maps port 1 -> 'wan' interface
# and LAN ports -> 'lan'.
#
# config portmap
#	option index 1
#	option interface 'eth0'